# Bluesky
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=your-bluesky-app-password

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_USERNAME=@your-public-channel

# Mastodon
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCOUNT_HANDLE=your-handle@mastodon.social
MASTODON_CLIENT_ID=your-mastodon-client-id
MASTODON_CLIENT_SECRET=your-mastodon-client-secret
MASTODON_ACCESS_TOKEN=your-mastodon-access-token

# Misskey
MISSKEY_BASE_URL=https://your-misskey-instance.example
MISSKEY_USERNAME=your-misskey-username
MISSKEY_ACCESS_TOKEN=your-misskey-token

# Lemmy (tested adapter version: API v3)
LEMMY_BASE_URL=https://your-lemmy-instance.example
LEMMY_USERNAME=your-local-username
LEMMY_PASSWORD=your-lemmy-password
LEMMY_COMMUNITY_NAME=your-public-community

# Protect POST /posting. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PUBLISH_API_KEY=replace-with-a-random-32-byte-value
